{
  "name": "sozocraft",
  "private": true,
  "version": "0.27.0",
  "type": "module",
  "scripts": {
    "cli": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin sozocraft-cli --",
    "cli:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin sozocraft-cli",
    "cli:install": "node scripts/install-cli.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:app": "tauri build --debug --bundles app",
    "test:frontend": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
